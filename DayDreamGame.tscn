[sub_resource type="GDScript" id="GDScript_ehnnt"]
resource_name = "gameManager"
script/source = "extends Node
var points=-3
@onready var points_label: Label = %pointsLabel

func add_point():
	points+=1
	print(points)
	points_label.text=\"Points \"+str(points)
"

